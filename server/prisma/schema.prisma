generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Roles are per organization: the same person can be an owner in one org and a member in another.
enum OrgRole {
  OWNER
  ADMIN
  MANAGER
  MEMBER
}

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  avatarUrl    String?
  passwordHash String?
  googleId     String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships      Membership[]
  createdTasks     Task[]         @relation("TaskCreator")
  assignedTasks    Task[]         @relation("TaskAssignee")
  refreshTokens    RefreshToken[]
  sentInvitations  Invitation[]   @relation("InvitedBy")
  auditEvents      AuditLog[]     @relation("AuditActor")
}

// A customer account (tenant). Every piece of work data hangs off an organization.
model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  plan      Plan     @default(FREE)
  seatLimit Int      @default(5)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
  invitations Invitation[]
  projects    Project[]
  tasks       Task[]
  auditLogs   AuditLog[]
}

model Membership {
  id        String   @id @default(cuid())
  role      OrgRole  @default(MEMBER)
  createdAt DateTime @default(now())

  userId String
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgId  String
  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
  @@index([orgId, role])
}

model Invitation {
  id         String    @id @default(cuid())
  email      String
  role       OrgRole   @default(MEMBER)
  tokenHash  String    @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invitedById String?
  invitedBy   User?        @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([orgId, email])
}

model Project {
  id          String    @id @default(cuid())
  name        String
  key         String    // short uppercase prefix for task numbers, e.g. "WEB" -> WEB-42
  description String?
  taskCounter Int       @default(0)
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@unique([orgId, key])
  @@index([orgId, archivedAt])
}

model Task {
  id             String     @id @default(cuid())
  number         Int
  title          String
  description    String?
  status         TaskStatus @default(TODO)
  priority       Priority   @default(MEDIUM)
  dueDate        DateTime?
  reminderSentAt DateTime?
  completedAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  orgId      String
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  projectId  String
  project    Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creatorId  String
  creator    User         @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  assigneeId String?
  assignee   User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@unique([projectId, number])
  @@index([orgId, status])
  @@index([orgId, assigneeId, status])
  @@index([orgId, dueDate])
  @@index([orgId, createdAt])
  @@index([orgId, completedAt])
}

// Append-only record of security- and admin-relevant actions, per organization.
model AuditLog {
  id         String   @id @default(cuid())
  action     String   // e.g. "member.role_changed", "task.deleted"
  entityType String
  entityId   String?
  metadata   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  orgId   String
  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  actorId String?
  actor   User?        @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([orgId, createdAt])
  @@index([orgId, action])
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}
