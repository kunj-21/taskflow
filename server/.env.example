NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173

DATABASE_URL=postgresql://taskflow:taskflow@localhost:5432/taskflow?schema=public
REDIS_URL=redis://localhost:6379

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

# Google OAuth (https://console.cloud.google.com/apis/credentials) — optional in dev
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# SMTP — leave blank in dev to log emails instead of sending
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="TaskFlow <no-reply@taskflow.dev>"

LOG_LEVEL=info
CACHE_TTL_SECONDS=60
